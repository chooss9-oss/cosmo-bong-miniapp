{
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
    "crons": [
    {
      "path": "/api/refresh-subcategories",
      "schedule": "0 3 * * *"
    },
        {
      "path": "/api/refresh-catalog",
      "schedule": "0 4 * * *"
    }
  ]
}